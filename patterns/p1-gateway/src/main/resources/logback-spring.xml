<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging for Pattern 1 — API Gateway (Issue #11).
  LogstashEncoder writes every log event as a single JSON object to stdout.
  Each field added via LogstashMarker (e.g. method, path, downstream, status,
  latencyMs, correlationId) appears as a first-class JSON key — parseable with jq.
-->
<configuration>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- Suppress noisy Spring Cloud Kubernetes bootstrap noise at WARN level -->
    <logger name="org.springframework.cloud.kubernetes" level="WARN"/>
    <logger name="io.fabric8" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>

</configuration>
